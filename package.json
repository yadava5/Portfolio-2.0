{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/archive/build-archive.mjs",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test:e2e:browser-smoke": "NEXT_PUBLIC_BASE_PATH= npm run build && NEXT_PUBLIC_BASE_PATH= playwright test tests/playwright/atlas.spec.ts tests/playwright/run-home.spec.ts --project=chromium-desktop --project=chromium-mobile --project=firefox-desktop --project=webkit-desktop --project=webkit-mobile",
    "test:e2e:performance": "NEXT_PUBLIC_BASE_PATH= npm run build && NEXT_PUBLIC_BASE_PATH= playwright test tests/playwright/performance-budget.spec.ts",
    "test:e2e:reduced-motion": "NEXT_PUBLIC_BASE_PATH= npm run build && NEXT_PUBLIC_BASE_PATH= playwright test tests/playwright/reduced-motion.spec.ts",
    "test:e2e:static-seo": "NODE_ENV=production NEXT_PUBLIC_BASE_PATH=/Portfolio-2.0 npm run build && NEXT_PUBLIC_BASE_PATH=/Portfolio-2.0 playwright test tests/playwright/static-seo.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "assets:budget": "node scripts/qa/check-asset-budgets.mjs",
    "test:contrast": "node scripts/qa/check-contrast.mjs",
    "test:seo": "node scripts/qa/check-static-export-seo.mjs",
    "test:proof": "node scripts/qa/check-proof-manifest.mjs",
    "resume:build": "node scripts/resume/render-resume.mjs",
    "resume:check": "node scripts/resume/check-resume.mjs",
    "assets:promote-proof": "node scripts/asset-truth/promote-proof-assets.mjs",
    "assets:derive": "node scripts/asset-truth/derive-display-variants.mjs",
    "assets:render-diagrams": "node scripts/asset-truth/render-architecture-diagrams.mjs",
    "assets:render-og": "node scripts/asset-truth/render-og-cards.mjs",
    "assets:check-og": "node scripts/asset-truth/render-og-cards.mjs --check",
    "build:home": "node scripts/run/build-home.mjs",
    "test:nameplate": "node scripts/qa/check-nameplate.mjs",
    "test:nameplate:negative": "node scripts/qa/check-nameplate-negative.mjs",
    "test:figures": "node scripts/qa/check-figures.mjs",
    "test:anchors": "node scripts/qa/check-anchors.mjs",
    "test:stations": "node scripts/qa/check-stations.mjs",
    "test:links": "node scripts/qa/check-links.mjs",
    "test:crosswalk": "node scripts/qa/check-crosswalk.mjs out",
    "test:beat-tables": "node scripts/qa/check-beat-tables.mjs",
    "test:cargo-fixture": "node scripts/qa/check-cargo-fixture.mjs",
    "test:cargo-fixture:record": "node scripts/qa/check-cargo-fixture.mjs --record",
    "verify:portfolio": "node scripts/qa/verify-portfolio.mjs"
  },
  "browserslist": [
    "chrome 128",
    "edge 128",
    "firefox 128",
    "safari 17.4"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.22",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.563.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/gsap": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "lighthouse": "^13.0.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
