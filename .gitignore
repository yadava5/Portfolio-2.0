# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/output/
/.playwright-cli/
/.superpowers/

# Generated Playwright visual artifacts belong under ignored output/playwright/.
# Keep generated screenshots and videos out of git unless explicitly promoted.
/tests/playwright/screenshots/**/*.png
/tests/playwright/critique-screenshots/**/*.png
/tests/playwright/videos/
/tests/playwright/audit-report.json
/tests/playwright/AUDIT-SUMMARY.txt
/tests/playwright/EXECUTIVE-SUMMARY.txt
/tests/playwright/QA-*.md
/tests/playwright/QA-*.txt
/tests/playwright/QA-*.json
!/tests/playwright/screenshots/.gitkeep

# next.js
/.next/
/out/

# Build byproducts that are NOT the artifact. tsconfig.head.json compiles
# src/lib/seo.ts to .build/head so build-home.mjs can import the site's
# metadata; nothing fetches those modules at runtime, so they have no business
# in out/ — which already ships ~263 KB no reader can reach.
/.build/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
AGENT-*
FEEDBACK-*
ASSESSMENT-*
TECHNICAL-*

# agent worktrees — a full second copy of this repo lives here while a
# sub-agent builds. `npm run lint` is `eslint .` from the root, so an
# un-ignored worktree gets linted as if it were source: one measured
# 307 errors / 8,975 warnings against a tree whose real count is
# 0 errors / 17 warnings. Never commit them, never lint them.
.claude/worktrees/

# Timing-audit measurement byproducts. The probes (census.mjs, analyze.mjs,
# inventory.mjs, video.mjs) regenerate all of this from the prototype, so the
# re-runnable script is the tracked evidence and the render is not:
#   video/  ~9.5 MB of webm walkthroughs + decoded frames
#   stills/ ~6.3 MB of PNGs captured at exact defect scroll positions
#   the raw sweep dumps the analysis JSONs are derived from
docs/design-lab/timing-audit/video/
docs/design-lab/timing-audit/stills/
docs/design-lab/timing-audit/opgrid-*.json
docs/design-lab/timing-audit/staticboxes-*.json
docs/design-lab/timing-audit/hover-*.json
docs/design-lab/timing-audit/census-*.json
