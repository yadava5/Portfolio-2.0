{
  /* The archive — `/projects/<id>/` × 7 and `/evidence/` — is generated by
     plain node from the same data layer the React app rendered from. That data
     is TypeScript with `@/` aliases, so it is compiled here and imported,
     exactly as `tsconfig.head.json` does for the head and `tsconfig.run.json`
     does for the nameplate.

     A SUPERSET OF tsconfig.head.json, kept separate rather than merged.
     build-home.mjs runs on every build and every e2e rebuild, and its compile
     is on that path; there is no reason to make it pull the proof manifest and
     the station table along too. Both emit outside out/.

     `stations.ts` is here because the archive's arrival slips and rejoin links
     are quoted from it verbatim — the run's own truth about its thirteen
     stops, which check-stations.mjs already holds the run to. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "outDir": ".build/archive",
    "rootDir": "src",
    "jsx": "preserve",
    "skipLibCheck": true,
    "incremental": false
  },
  "include": [
    "src/lib/seo.ts",
    "src/lib/data/projectCaseStudies.ts",
    "src/lib/data/proofManifest.ts",
    "src/lib/data/stations.ts"
  ]
}
